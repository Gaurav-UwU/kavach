# Kavach — AI configuration
# Primary: Gemini (vision-capable, handles screenshots — free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Fallback: Groq (used only when Gemini is absent or failing — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: a vision-capable Groq model id for screenshot analysis on the Groq path.
# If unset, screenshots fall back to the offline rules engine (or Gemini above).
# GROQ_VISION_MODEL=

# Without any key the app falls back to the built-in offline rules engine.
