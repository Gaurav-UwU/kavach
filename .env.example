# Kavach — AI configuration
# Primary: Groq (free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: a vision-capable Groq model id for screenshot analysis.
# If unset, screenshots fall back to the offline rules engine (or Gemini below).
# GROQ_VISION_MODEL=

# Optional fallback engine (used only when GROQ_API_KEY is absent)
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Without any key the app falls back to the built-in offline rules engine.
